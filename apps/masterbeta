  new DataView(out.buffer).setUint32(4,b.length,true);out.set(b,8);return out;};
 const parts=[field('INAM',meta.title),field('IART',meta.artist),field('IPRD',meta.album),
 field('ICRD',String(meta.year)),field('ICOP',meta.copyright),field('ISFT','MASTER BETA'),field('ICMT',meta.comment)];
 const infoBody=new Uint8Array(4+parts.reduce((a,c)=>a+c.length,0));
 infoBody.set(enc.encode('INFO'),0);let o=4;
 for(const p of parts){infoBody.set(p,o);o+=p.length;}
 const list=new Uint8Array(8+infoBody.length);
 list.set(enc.encode('LIST'),0);
 new DataView(list.buffer).setUint32(4,infoBody.length,true);list.set(infoBody,8);
 const hist=enc.encode('A=PCM,F='+sr+',W=24,M='+(nCh===2?'stereo':'mono')+',T=MASTER BETA 24-bit master; '+meta.copyright+'\r\n');
 const body=new Uint8Array(594+hist.length);
 const wfix=(off,str,len)=>{const b=enc.encode(str||'');for(let i=0;i<len;i++)body[off+i]=i<b.length?b[i]:0;};
 wfix(0,(meta.isrc?'ISRC '+meta.isrc+'. ':'')+meta.copyright,256);
 wfix(256,'MASTER BETA',32);wfix(288,meta.isrc||'',32);
 wfix(320,new Date().toISOString().slice(0,10),10);
 wfix(330,new Date().toTimeString().slice(0,8),8);
 new DataView(body.buffer).setUint16(338,1,true);
 body.set(hist,594);
 const bext=new Uint8Array(8+body.length);
 bext.set(enc.encode('bext'),0);
 new DataView(bext.buffer).setUint32(4,body.length,true);bext.set(body,8);
 const total=4+(8+16)+(8+list.length)+(8+bext.length-8)+(8+dataBytes);
 const out=new Uint8Array(8+total);const dv=new DataView(out.buffer);let p=0;
 const ws=s=>{for(let i=0;i<s.length;i++)out[p++]=s.charCodeAt(i);};
 ws('RIFF');dv.setUint32(p,total,true);p+=4;ws('WAVE');
 ws('fmt ');dv.setUint32(p,16,true);p+=4;
 dv.setUint16(p,1,true);p+=2;dv.setUint16(p,nCh,true);p+=2;
 dv.setUint32(p,sr,true);p+=4;dv.setUint32(p,sr*nCh*3,true);p+=4;
 dv.setUint16(p,nCh*3,true);p+=2;dv.setUint16(p,24,true);p+=2;
 out.set(list,p);p+=list.length;out.set(bext,p);p+=bext.length;
 ws('data');dv.setUint32(p,dataBytes,true);p+=4;
 for(let i=0;i<n;i++)for(let c=0;c<nCh;c++){
  let v=clamp(chans[c][i],-1,1)*8388607;
  if(S.out.dither)v+=(Math.random()+Math.random()-1)*(2/8388607);
  const iv=v<0?Math.max(-8388608,Math.round(v)):Math.min(8388607,Math.round(v));
  out[p++]=iv&0xff;out[p++]=(iv>>8)&0xff;out[p++]=(iv>>16)&0xff;}
 return out;}
function ext80(rate){const e=Math.floor(Math.log2(rate));const shift=63-e;
