 const enc=new TextEncoder();
 const fr=frames.map(pair=>{const b=enc.encode(pair[1]||'');
  const f=new Uint8Array(11+b.length);
  for(let i=0;i<4;i++)f[i]=pair[0].charCodeAt(i);
  const sz=1+b.length;
  f[4]=sz>>>24&255;f[5]=sz>>>16&255;f[6]=sz>>>8&255;f[7]=sz&255;
  f[10]=0;f.set(b,11);return f;});
 const body=fr.reduce((a,f)=>{const r=new Uint8Array(a.length+f.length);r.set(a);r.set(f,a.length);return r;},new Uint8Array(0));
 const head=new Uint8Array(10);
 head.set([0x49,0x44,0x33,3,0,0],0);
 const sz=body.length;
 head[6]=(sz>>>21)&127;head[7]=(sz>>>14)&127;head[8]=(sz>>>7)&127;head[9]=sz&127;
 const out=new Uint8Array(10+body.length);out.set(head);out.set(body,10);return out;}
function encodeMp3(chans,sr,meta){
 if(typeof lamejs==='undefined'||!lamejs.Mp3Encoder)return null;
 const enc=new lamejs.Mp3Encoder(2,sr,320);
 const n=chans[0].length,B=1152;
 const l=new Int16Array(B),r=new Int16Array(B);
 const chunks=[id3v2([['TIT2',meta.title],['TPE1',meta.artist],['TALB',meta.album],
  ['TYER',String(meta.year)],['TCOP',meta.copyright]])];
 for(let i=0;i<n;i+=B){
  const len=Math.min(B,n-i);
  for(let j=0;j<len;j++){
   const a=clamp(chans[0][i+j],-1,1),b=clamp(chans[1][i+j],-1,1);
   l[j]=a<0?a*32768:a*32767;r[j]=b<0?b*32768:b*32767;}
  const buf=enc.encodeBuffer(l.subarray(0,len),r.subarray(0,len));
  if(buf.length)chunks.push(new Uint8Array(buf));}
 const end=enc.flush();
 if(end.length)chunks.push(new Uint8Array(end));
 return chunks.reduce((a,c)=>{const r2=new Uint8Array(a.length+c.length);r2.set(a);r2.set(c,a.length);return r2;},new Uint8Array(0));}

async function resampleRT(chans,sr){
 const other=sr===44100?48000:44100;
 const n=chans[0].length;
 const b1=AC.createBuffer(2,n,sr);
 b1.copyToChannel(chans[0],0);b1.copyToChannel(chans[1],1);
 const render=async(rate,srcBuf,len)=>{
  const c=new OfflineAudioContext(2,Math.max(1,Math.round(len)),rate);
  const s=c.createBufferSource();s.buffer=srcBuf;s.connect(c.destination);s.start(0);
  return await c.startRendering();};
 const mid=await render(other,b1,n*other/sr);
 const back=await render(sr,mid,mid.length*sr/other);
 const L2=Math.min(n,back.length);
 return[[Float32Array.from(back.getChannelData(0).subarray(0,L2)),
        Float32Array.from(back.getChannelData(1).subarray(0,L2))],sr];}
async function lossyRT(chans,sr){
 const bytes=encodeMp3(chans,sr,{title:'wm',artist:'',album:'',year:'',comment:'',copyright:''});
 if(!bytes)throw new Error('MP3 encoder unavailable (CDN blocked)');
 const buf=await AC.decodeAudioData(bytes.buffer);
 return[[Float32Array.from(buf.getChannelData(0)),
        Float32Array.from(buf.getChannelData(1))],buf.sampleRate];}
async function auditionMp3(){
 if(!S.master)return;
 $('#overlay').hidden=false;
 try{await stage('Codec preview: MP3 320 round-trip…',150);
  const rt=await lossyRT(S.master.chans,S.master.sr);
  const chans=rt[0],sr=rt[1];
  const pb=AC.createBuffer(2,chans[0].length,sr);
  pb.copyToChannel(chans[0],0);pb.copyToChannel(chans[1],1);
  S.preview=pb;
  $('#overlay').hidden=true;
  enterExact();
  toast('MP3 320 audition on B — hear the codec damage. Export is unaffected.','ok');
 }catch(e){$('#overlay').hidden=true;toast('Codec preview failed: '+e.message,'err');}}
async function exportFile(){
 if(!S.master)return;
 try{
  let chans=S.master.chans.map(c=>c.slice(0)),sr=S.master.sr;
  if(S.out.wmResample){$('#overlay').hidden=false;
   await stage('WM guard: resample round-trip…',150);
   const rt=await resampleRT(chans,sr);chans=rt[0];sr=rt[1];}
  if(S.out.wmLossy){
   await stage('WM guard: lossy round-trip…',150);
   try{const rt=await lossyRT(chans,sr);chans=rt[0];sr=rt[1];}
   catch(e){toast('Lossy round-trip skipped: '+e.message,'warn');}}
  $('#overlay').hidden=true;
  const meta={title:S.clean.title||'Untitled',artist:S.clean.artist||'',album:S.clean.album||'',
   year:S.clean.year||String(new Date().getFullYear()),isrc:S.clean.isrc,comment:S.clean.comment,
   copyright:copyrightLine()};
  let bytes,mime,ext;
  if(S.out.fmt==='aiff'){bytes=encodeAiff24(chans,sr,meta);mime='audio/aiff';ext='aiff';}
  else if(S.out.fmt==='mp3'){bytes=encodeMp3(chans,sr,meta);
   if(!bytes){toast('MP3 encoder unavailable (CDN blocked) — exported 24-bit WAV instead','warn');
    bytes=encodeWav24(chans,sr,meta);mime='audio/wav';ext='wav';}
   else{mime='audio/mpeg';ext='mp3';}}
  else{bytes=encodeWav24(chans,sr,meta);mime='audio/wav';ext='wav';}
  const blob=new Blob([bytes],{type:mime});
  const a=document.createElement('a');
  const safe=(S.clean.title||'master').replace(/[^\w\- ]+/g,'').trim()||'master';
  a.download=safe+' [master].'+ext;
  a.href=URL.createObjectURL(blob);
  a.style.display='none';
  document.body.appendChild(a);
  a.click();
  setTimeout(()=>{a.remove();URL.revokeObjectURL(a.href);},5000);
  toast('Downloading: '+a.download,'ok');
 }catch(err){$('#overlay').hidden=true;toast('Export failed: '+err.message,'err');}}

function tickLoop(){
 if(PB.playing&&srcNode){
  const d=playBuf()?playBuf().duration:0;
  PB.pos=curPos();
  if(!PB.loop&&d>0&&PB.pos>=d-.01){PB.pos=0;PB.playing=false;stopSrc();$('#btnPlay').textContent='▶';}
  $('#tCur').textContent=fmtTime(PB.pos);
  const ph=$('#playhead');
  if(d>0){ph.style.display='block';ph.style.left=(PB.pos/d*100)+'%';}}
 drawSpec();updTB();drawTB();drawMeter();drawGR();
 if(S.buffer&&!$('#app').hidden)drawEQ();
 requestAnimationFrame(tickLoop);}
function init(){
 window.__mfLoad=loadFile;
 try{
  [['#repairGrid',p=>p.ai],['#presetGrid',p=>!p.ai]].forEach(pair=>{
   const pg=$(pair[0]);
   PRESETS.filter(pair[1]).forEach(p=>{const b=document.createElement('button');
    b.className='pchip';b.dataset.id=p.id;
    b.innerHTML='<b>'+p.name+'</b><small>'+p.desc+'</small>';
    b.addEventListener('click',()=>applyPreset(p));pg.appendChild(b);});});
  buildConsole();
  initBandUI();
  document.querySelectorAll('.tabbar .tab').forEach(b=>b.addEventListener('click',()=>setTab(b.dataset.t)));
  Object.entries(CLEANMAP).forEach(pair=>{$('#'+pair[0]).addEventListener('input',e=>{S.clean[pair[1]]=e.target.value;updCop();});});
  $('#selFmt').addEventListener('change',e=>{S.out.fmt=e.target.value;updExportBtn();updateChecklist();});
  $('#btnPlay').addEventListener('click',togglePlay);
  $('#abA').addEventListener('click',()=>setAB('A'));
  $('#abB').addEventListener('click',()=>setAB('B'));
  $('#btnLoop').addEventListener('click',()=>{PB.loop=!PB.loop;
   if(srcNode)srcNode.loop=PB.loop;
   $('#btnLoop').classList.toggle('on',PB.loop);});
  $('#btnLuMatch').addEventListener('click',()=>{S.luMatch=!S.luMatch;
   $('#btnLuMatch').classList.toggle('on',S.luMatch);
   rampAB();
   toast(S.luMatch?'LU-match ON — B attenuated to source loudness (fair A/B)':'LU-match OFF — B at target loudness');});
  $('#btnAssist').addEventListener('click',runAssistant);
  $('#btnAudMp3').addEventListener('click',auditionMp3);
  $('#sVol').addEventListener('input',e=>volNode.gain.value=+e.target.value);
  $('#waveWrap').addEventListener('click',e=>{
   if(!S.buffer)return;
   const rc=e.currentTarget.getBoundingClientRect();
   const d=playBuf()?playBuf().duration:S.buffer.duration;
   PB.pos=clamp((e.clientX-rc.left)/rc.width,0,1)*d;
   if(PB.playing)startPlayback();});
  $('#btnProcess').addEventListener('click',()=>{AC.resume();process();});
  $('#btnExport').addEventListener('click',exportFile);
  $('#btnRevert').addEventListener('click',()=>{
   if(!S.snap){toast('No saved settings yet','warn');return;}
   S.chain=cp(S.snap.chain);S.out=cp(S.snap.out);S.clean=cp(S.snap.clean);
   S.presetId='';S.isoBand=null;
   syncUI();markDirty();toast('Reverted to saved settings','ok');});
  $('#btnSave').addEventListener('click',saveSettingsFile);
  $('#btnLoadSet').addEventListener('click',()=>$('#setIn').click());
  $('#setIn').addEventListener('change',e=>{
   const f=e.target.files&&e.target.files[0];
   if(f)loadSettingsFile(f);e.target.value='';});
  $('#saveName').addEventListener('keydown',e=>{if(e.key==='Enter')saveSettingsFile();});
  window.addEventListener('keydown',e=>{
   const tg=document.activeElement&&document.activeElement.tagName;
   if(tg==='INPUT'||tg==='TEXTAREA'||tg==='SELECT')return;
   if(!S.buffer)return;
   if(e.code==='Space'){e.preventDefault();togglePlay();}
   else if(e.key==='a'||e.key==='A')setAB('A');
   else if(e.key==='b'||e.key==='B')setAB('B');
   else if(e.key==='l'||e.key==='L')$('#btnLoop').click();
   else if(e.key==='m'||e.key==='M')$('#btnLuMatch').click();});
  window.addEventListener('resize',()=>{eqRespCache=null;drawEQ();
   if(S.buffer){drawWave($('#waveA'),S.buffer,'#5d6d84');
   if(S.preview)drawWave($('#waveB'),S.preview,'#38e1ff');}});
  applyPreset(PRESETS.find(p=>p.id==='ai-standard'));
  setTab('f');
  updateChecklist();updateBLabels();
  requestAnimationFrame(tickLoop);
  drawEQ();
  if(window.__mfOK)window.__mfOK();
  console.log('[MASTER BETA] ready — engine initialized');
 }catch(e){
  console.error('[MASTER BETA] startup error',e);
  toast('Startup error: '+e.message,'err');}}
init();
