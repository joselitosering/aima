function fftInPlace(re,im){const n=re.length;
 for(let i=1,j=0;i<n;i++){let b=n>>1;for(;j&b;b>>=1)j^=b;j^=b;
  if(i<j){let t=re[i];re[i]=re[j];re[j]=t;t=im[i];im[i]=im[j];im[j]=t;}}
 for(let len=2;len<=n;len<<=1){const ang=-2*Math.PI/len,wr=Math.cos(ang),wi=Math.sin(ang),half=len>>1;
  for(let i=0;i<n;i+=len){let cr=1,ci=0;
   for(let k=0;k<half;k++){const a=i+k,b2=i+k+half;
    const vr=re[b2]*cr-im[b2]*ci,vi=re[b2]*ci+im[b2]*cr;
    re[b2]=re[a]-vr;im[b2]=im[a]-vi;re[a]+=vr;im[a]+=vi;
    const t2=cr*wr-ci*wi;ci=cr*wi+ci*wr;cr=t2;}}}}
function analyzeSource(){
 const buf=S.buffer;if(!buf)return null;
 const sr=buf.sampleRate,L=buf.getChannelData(0),R=buf.numberOfChannels>1?buf.getChannelData(1):L;
 const N=8192,n=buf.length;
 if(n<N)return null;
 const wins=Math.min(6,Math.max(2,Math.floor(n/N)));
 const acc=new Float64Array(N/2);
 const re=new Float32Array(N),im=new Float32Array(N);
 let used=0,rmsSum=0,rmsCnt=0;
 for(let w=0;w<wins;w++){
  const start=Math.min(n-N,Math.floor(w*n/wins));
  let s2=0;
  for(let i=0;i<N;i++){const v=(L[start+i]+R[start+i])*.5;s2+=v*v;
   re[i]=v*(.5-.5*Math.cos(2*Math.PI*i/N));im[i]=0;}
  const rms=Math.sqrt(s2/N);
  if(rms<1e-4)continue;
  rmsSum+=20*Math.log10(rms);rmsCnt++;
  fftInPlace(re,im);
  for(let i=0;i<N/2;i++)acc[i]+=re[i]*re[i]+im[i]*im[i];
  used++;}
 if(!used)return null;
 for(let i=0;i<acc.length;i++)acc[i]/=used;
 const binHz=sr/N;
 const band=(f0,f1)=>{let s=0,c=0;
  const b0=Math.max(1,Math.floor(f0/binHz)),b1=Math.min(acc.length-1,Math.ceil(f1/binHz));
  for(let b=b0;b<=b1;b++){s+=acc[b];c++;}return 10*Math.log10(Math.max(s/Math.max(1,c),1e-20));};
 const bands={sub:band(30,120),low:band(120,350),mid:band(350,2000),high:band(2000,5000),fizz:band(5000,10000),air:band(10000,16000)};
 return{bands:bands,rmsDb:rmsCnt?rmsSum/rmsCnt:-60};}
