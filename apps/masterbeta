async function process(){
 if(!S.buffer)return;
 $('#overlay').hidden=false;
 try{
  await stage('Glue compressor (instrumented)…',100);
  const sr=S.buffer.sampleRate,len=S.buffer.length;
  const pre=[];
  for(let c=0;c<2;c++)pre.push(Float32Array.from(S.buffer.getChannelData(Math.min(c,S.buffer.numberOfChannels-1))));
  let cpGR={peakGR:0,avgGR:0};
  if(S.chain.cp.on){
   const k=S.chain.cp;
   const mk=(k.mk?Math.abs(k.thr)*(1-1/k.ratio)*.85:0)+k.gain;
   cpGR=compressJS(pre,sr,k.thr,k.ratio,k.atk,k.rel,mk);}
  const preBuf=AC.createBuffer(2,len,sr);
  preBuf.copyToChannel(pre[0],0);preBuf.copyToChannel(pre[1],1);
  await stage('Rendering mastering chain…',120);
  OFFLINE_NO_CP=true;
  const ctx=new OfflineAudioContext(2,len,sr);
  const N=buildChain(ctx,true);
  const src=ctx.createBufferSource();src.buffer=preBuf;
  src.connect(N.in);N.out.connect(ctx.destination);src.start(0);
  const rendered=await ctx.startRendering();
  OFFLINE_NO_CP=false;
  await stage('Normalizing loudness · limiting…',150);
  const chans=[];
  for(let c=0;c<rendered.numberOfChannels;c++)chans.push(Float32Array.from(rendered.getChannelData(c)));
  if(chans.length===1)chans.push(chans[0].slice(0));
  while(chans.length>2)chans.pop();
  const inLufs=measureLufs(chans,sr);
  const gainDb=isFinite(inLufs)?clamp(S.out.lufs-inLufs,-24,24):0;
  const g0=dbToLin(gainDb);
  for(const ch of chans)for(let i=0;i<ch.length;i++)ch[i]*=g0;
  const ceil=dbToLin(S.out.ceil);
  const grData=limit(chans,sr,ceil);
  let tp=truePeak(chans);
  if(tp>ceil){const k=ceil/tp;for(const ch of chans)for(let i=0;i<ch.length;i++)ch[i]*=k;tp=truePeak(chans);}
  fadeEdges(chans,sr);
  const outLufs=measureLufs(chans,sr);
  await stage('Measuring BS.1770 loudness…',150);
  S.master={chans:chans,sr:sr,outLufs:outLufs,gainDb:gainDb,tpDb:linToDb(tp),spkDb:linToDb(samplePeak(chans)),corr:corrChans(chans),
   cpPeakGR:cpGR.peakGR,cpAvgGR:cpGR.avgGR,limPeakGR:grData.peakGR,limAvgGR:grData.avgGR};
  const pb=AC.createBuffer(2,chans[0].length,sr);
  pb.copyToChannel(chans[0],0);pb.copyToChannel(chans[1],1);
  S.preview=pb;
  $('#mLufs').textContent=outLufs.toFixed(1)+' LUFS';
  $('#mTp').textContent=fmtDb(S.master.tpDb);$('#mSpk').textContent=fmtDb(S.master.spkDb);
  $('#mGain').textContent=(gainDb>0?'+':'')+gainDb.toFixed(1)+' dB';
  $('#mCorr').textContent=S.master.corr.toFixed(2);
  $('#aNote').textContent='Exact master: '+outLufs.toFixed(1)+' LUFS · '+S.master.tpDb.toFixed(2)+' dBTP · glue GR '+cpGR.peakGR.toFixed(1)+'/'+cpGR.avgGR.toFixed(1)+' dB · limiter GR '+grData.peakGR.toFixed(1)+'/'+grData.avgGR.toFixed(1)+' dB (pk/avg).';
  drawWave($('#waveB'),pb,'#38e1ff');
  $('#btnExport').disabled=false;$('#btnAudMp3').disabled=false;
  updateChecklist();updateLEDs();takeSnap();
  $('#overlay').hidden=true;
  enterExact();
  setTab('e');
  toast('Master rendered — glue GR '+cpGR.peakGR.toFixed(1)+'/'+cpGR.avgGR.toFixed(1)+' · limiter GR '+grData.peakGR.toFixed(1)+'/'+grData.avgGR.toFixed(1)+' dB (pk/avg)','ok');
 }catch(err){OFFLINE_NO_CP=false;$('#overlay').hidden=true;toast('Processing failed: '+err.message,'err');}}

function encodeWav24(chans,sr,meta){
